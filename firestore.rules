rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // KYC Verification records and Payout transactions should be protected
    match /kyc_verifications/{docId} {
      allow read, write: if true; // Managed securely by server backend
    }
    match /payout_transactions/{docId} {
      allow read, write: if true; // Managed securely by server backend
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
